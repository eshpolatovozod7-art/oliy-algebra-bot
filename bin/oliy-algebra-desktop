#!/usr/bin/env bash
# Oliy Algebra Solver - Native Desktop Launcher
set -e

DESKTOP_DIR="/home/ozodbek/Projects/oliy-algebra-bot/desktop"

# Agar electron mavjud bo'lsa, to'liq mustaqil mahalliy desktop ilovani ishga tushirish (Wayland native)
if command -v electron43 >/dev/null 2>&1; then
    exec /usr/bin/electron43 "${DESKTOP_DIR}" --ozone-platform-hint=auto "$@"
elif command -v electron >/dev/null 2>&1; then
    exec electron "${DESKTOP_DIR}" --ozone-platform-hint=auto "$@"
else
    # Zaxira varianti: Chromium orqali ochish
    exec chromium --app="file:///home/ozodbek/Projects/oliy-algebra-bot/webapp/index.html" --class="oliy-algebra" "$@"
fi
